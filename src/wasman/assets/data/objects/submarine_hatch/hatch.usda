#usda 1.0
(
    defaultPrim = "Hatch"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Hatch"
{
    def "Looks"
    {
        def Material "Paint" (
            prepend references = @../../panels/ship_green/panel.usda@</Panel/Material>
        )
        {
            token outputs:surface.connect = </Hatch/Looks/Paint/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.2, 0.17)
                float inputs:metallic = 0.55
                float inputs:roughness = 0.48
                token outputs:surface
            }
        }

        def Material "Steel"
        {
            token outputs:surface.connect = </Hatch/Looks/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.34, 0.38, 0.39)
                float inputs:metallic = 0.95
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </Hatch/Looks/Rubber/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.019, 0.025, 0.026)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "Brass"
        {
            token outputs:surface.connect = </Hatch/Looks/Brass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.28, 0.1)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.34
                token outputs:surface
            }
        }
    }

    def Xform "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysicsMassAPI"]
    )
