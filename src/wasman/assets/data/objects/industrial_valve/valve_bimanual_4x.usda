#usda 1.0
(
    defaultPrim = "Valve"
    doc = """Generated from Composed Stage of root layer valve.usdc
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Valve"
{
    def Material "Metal"
    {
        token outputs:surface.connect = </Valve/Metal/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            float3 inputs:diffuseColor.connect = </Valve/Metal/diff.outputs:rgb>
            float inputs:metallic.connect = </Valve/Metal/metal.outputs:r>
            float3 inputs:normal.connect = </Valve/Metal/nor_gl.outputs:rgb>
            float inputs:roughness.connect = </Valve/Metal/rough.outputs:r>
            token outputs:surface
        }

        def Shader "UV"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "diff"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/modular_industrial_pipes_01_group02_diff_2k.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </Valve/Metal/UV.outputs:result>
            float3 outputs:rgb
        }

        def Shader "rough"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/modular_industrial_pipes_01_group02_rough_2k.png@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Valve/Metal/UV.outputs:result>
            float outputs:r
        }

        def Shader "metal"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/modular_industrial_pipes_01_group02_metal_2k.png@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Valve/Metal/UV.outputs:result>
            float outputs:r
        }

        def Shader "nor_gl"
        {
            uniform token info:id = "UsdUVTexture"
            float4 inputs:bias = (-1, -1, -1, 0)
            asset inputs:file = @textures/modular_industrial_pipes_01_group02_nor_gl_2k.png@
            float4 inputs:scale = (2, 2, 2, 1)
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Valve/Metal/UV.outputs:result>
            float3 outputs:rgb
        }
    }

    def Material "ContactMaterial" (
        apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.6
        float physics:restitution = 0
        float physics:staticFriction = 0.8
    }

    def Xform "base_link" (
        apiSchemas = ["PhysicsArticulationRootAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 physics:diagonalInertia = (0, 0, 0)
        float physics:mass = 192

