        }

        def Material "SafetyOchre"
        {
            token outputs:surface.connect = </SliderWithRail/Looks/SafetyOchre/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.4, 0.045)
